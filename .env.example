# Copy to .env at the monorepo root. Production serves the frontend on the same port.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins. Set to the exact HTTPS domain in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only behind a trusted single reverse proxy (Render/Railway).
TRUST_PROXY=0
MAX_ROOMS=500
MAX_PLAYERS=40
DISCONNECT_GRACE_MS=120000
EMPTY_ROOM_TTL_MS=600000
