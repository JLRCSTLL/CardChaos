# Copy to .env at the monorepo root. Both Vite and the server read this location.
# Leave blank when Express serves the frontend (local / Render / Railway).
# For Vercel, set this in the Vercel project environment BEFORE building:
# VITE_GAME_SERVER_URL=https://YOUR-SERVER.onrender.com
# This is a public URL, never a secret. Do not append /socket.io or /api.
VITE_GAME_SERVER_URL=
PORT=3001
HOST=0.0.0.0
# Set NODE_ENV=production on the deployed Node service. Let Vite set it locally.
# Server only: comma-separated browser origins, without trailing slashes.
# For the Vercel frontend, set ALLOWED_ORIGINS=https://cardchaos.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only behind a trusted single reverse proxy (Render/Railway).
TRUST_PROXY=0
MAX_ROOMS=500
MAX_PLAYERS=40
DISCONNECT_GRACE_MS=120000
EMPTY_ROOM_TTL_MS=600000
