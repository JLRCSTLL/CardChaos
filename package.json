{
  "name": "card-chaos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev -w @card-chaos/server\" \"npm run dev -w @card-chaos/web\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run build -w @card-chaos/web && node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write apps packages tests scripts *.json *.ts *.yaml .github/workflows/*.yml",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  }
}
